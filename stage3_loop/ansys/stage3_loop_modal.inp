! =====================================================================
! MECH0074 CW1 - Stage 3: expansion-loop in-plane modal analysis (v5)
! Mechanical APDL 2023 R1, SI units (m, kg, s, Pa)
!
! Runs a table of cases (loop size, guide position, bend element,
! mesh) and writes:
!   stage3_results.csv        frequency of modes 1-NMODE for every case
! then re-solves the baseline and writes, for Stage 4:
!   stage3_bend_geometry.csv          bend stations s, arc centres,
!                                     midpoints, force directions, turn
!   stage3_modeshapes_baseline.csv    UX, UY, ROTZ of every node, modes 1-6
!   stage3_modeshapes_at_bends.csv    mode shape at each bend midpoint and
!                                     its projection on the bend force
! and saves the baseline mode-shape PNGs (file*.png).
!
! Geometry (plan view, XY plane = horizontal):
!
!                 B2 ---- W ---- B3
!                  |              |
!                  H              H
!                  |              |
!   A1 ==g==g==== B1              B4 ====g==g== A2
!   (reservoir end)                       (valve end)
!
!   A = anchor (all DOF fixed), g = guide (lateral UY fixed, slides
!   axially), B = 90 deg tangent bend, radius 1.4 m (brief).
!   Inlet/outlet legs are sized so the developed length is LTOT
!   (100 m, the Stage 1 benchmark length) for every loop size.
!
! Modelling choices (record in the assumptions log):
!  - BENDEL=1: ELBOW290 for the whole line (captures bend ovalisation,
!    i.e. bend flexibility; straight ELBOW290 also lets the tangent
!    pipe restrain ovalisation naturally). BENDEL=0: PIPE289 throughout
!    (no ovalisation, stiff bends) - for comparison only.
!  - In-plane only: UZ, ROTX, ROTY fixed at all nodes (vertical support
!    from sleepers/shoes; brief asks for in-plane modes).
!  - Guides: UY fixed at the guide node; axial sliding is frictionless.
!  - LNG mass via effective density (same as Stage 2).
!  - Internal pressure not applied (modal, unpressurised bends ->
!    most flexible case; pressure stiffening is discussed separately).
! =====================================================================
! (no /CLEAR here: start from a fresh MAPDL session instead)
/UIS,MSGPOP,3      ! GUI: only errors open a pop-up (warnings/notes do not
                   ! stop the input file waiting for a click)
/NERR,,99999999    ! do not stop on accumulated warnings
/TITLE,MECH0074 Stage 3 - expansion loop modes

! ---------------- fixed inputs ----------------
DOUT  = 0.813
DINN  = 0.79394
TWALL = (DOUT-DINN)/2
EYM   = 213.233E9
NUP   = 0.3
RHOS  = 8000
RHOF  = 455
RBEND = 1.4          ! bend radius of curvature [m] (brief)
LTOT  = 100          ! developed length reservoir -> valve [m]
GSPC  = 12           ! spacing between successive guides [m]
NMODE = 6            ! modes to extract
PIV   = ACOS(-1)
ASTL  = PIV/4*(DOUT**2-DINN**2)
AFLD  = PIV/4*DINN**2
RHOEF = (RHOS*ASTL+RHOF*AFLD)/ASTL

! ---------------- case table ----------------
! rows: 1 H [m], 2 W [m], 3 first-guide distance GD from bend
! tangent [m] (-1 = no guides), 4 BENDEL, 5 element size [m],
! 6 elements per 90 deg bend, 7 KEYOPT(2) Fourier terms (ELBOW290)
NCASE = 18
*DIM,CS,ARRAY,7,NCASE   ! one COLUMN per case (APDL fills lists down a column)
! v5: all ELBOW290 cases use 8 Fourier terms (KEYOPT(2)=8, the maximum).
! v4 showed 2 terms (the default) is not converged for this thin wall
! (D/t ~ 85): mode 1 fell 27% from 2 to 4 terms. Cases 13-18 sweep 2-7.
! baseline
CS(1,1)  = 12, 8,  6, 1, 0.25,  8, 8
! loop size
CS(1,2)  =  8, 8,  6, 1, 0.25,  8, 8
CS(1,3)  = 16, 8,  6, 1, 0.25,  8, 8
CS(1,4)  = 12, 4,  6, 1, 0.25,  8, 8
CS(1,5)  = 12, 12, 6, 1, 0.25,  8, 8
! guide restraint
CS(1,6)  = 12, 8,  3, 1, 0.25,  8, 8
CS(1,7)  = 12, 8, 12, 1, 0.25,  8, 8
CS(1,8)  = 12, 8, -1, 1, 0.25,  8, 8
! bend model (PIPE289, no ovalisation)
CS(1,9)  = 12, 8,  6, 0, 0.25,  8, 8
! mesh checks on the baseline
CS(1,10) = 12, 8,  6, 1, 0.5,   4, 8
CS(1,11) = 12, 8,  6, 1, 0.125, 16, 8
CS(1,12) = 12, 8,  6, 1, 0.25,  16, 8
! ovalisation (Fourier-term) convergence on the baseline
CS(1,13) = 12, 8,  6, 1, 0.25,  8, 2
CS(1,14) = 12, 8,  6, 1, 0.25,  8, 3
CS(1,15) = 12, 8,  6, 1, 0.25,  8, 4
CS(1,16) = 12, 8,  6, 1, 0.25,  8, 5
CS(1,17) = 12, 8,  6, 1, 0.25,  8, 6
CS(1,18) = 12, 8,  6, 1, 0.25,  8, 7

*DIM,FR,ARRAY,NMODE
*DIM,UM,ARRAY,NMODE

! ---------------- element types, section, material ----------------
/PREP7
ET,1,PIPE289
ET,2,ELBOW290
SECTYPE,1,PIPE
SECDATA,DOUT,TWALL,32     ! 32 cells around the wall: resolves up to 8 Fourier terms
MP,EX,1,EYM
MP,PRXY,1,NUP
MP,DENS,1,RHOEF
FINISH


! ---------------- run all cases ----------------
*CFOPEN,stage3_results,csv
*VWRITE
('case,H_m,W_m,guide_dist_m,bend_elbow290,elem_size_m,elem_per_bend,fourier_terms,mode,freq_Hz,max_disp_massnorm')
*CFCLOS

! case NCASE+1 re-solves the baseline so its model is left in memory
! for the Stage 4 exports and the plots below
*DO,IC,1,NCASE+1
  JC = IC
  *IF,IC,GT,NCASE,THEN
    JC = 1
  *ENDIF
  HL     = CS(1,JC)
  WL     = CS(2,JC)
  GD     = CS(3,JC)
  BENDEL = CS(4,JC)
  ESZ    = CS(5,JC)
  NBND   = CS(6,JC)
  NFOUR  = CS(7,JC)
! ---------- build + solve one case ----------
/PREP7
DDELE,ALL,ALL
LCLEAR,ALL
LDELE,ALL,,,1
NUMCMP,ALL
KEYOPT,2,2,NFOUR
! straight legs so that developed length = LTOT
DRND = 4*(2*RBEND-PIV*RBEND/2)
LIN  = (LTOT-2*HL-WL+DRND)/2
XEND = 2*LIN+WL
K,1,0,0,0
K,2,LIN,0,0
K,3,LIN,HL,0
K,4,LIN+WL,HL,0
K,5,LIN+WL,0,0
K,6,XEND,0,0
L,1,2
L,2,3
L,3,4
L,4,5
L,5,6
*GET,NLST,LINE,0,NUM,MAX
LFILLT,1,2,RBEND
LFILLT,2,3,RBEND
LFILLT,3,4,RBEND
LFILLT,4,5,RBEND
! straights by size, arcs by divisions
LSEL,S,LINE,,1,NLST
LESIZE,ALL,ESZ
LSEL,S,LINE,,NLST+1,NLST+4
LESIZE,ALL,,,NBND
LSEL,ALL
TYPE,BENDEL+1
MAT,1
SECNUM,1
LMESH,ALL
! work only with the pipe-centreline nodes (ELBOW290 also creates
! internal section nodes, which must not receive these constraints)
LSEL,ALL
NSLL,S,1
CM,CLNODE,NODE
! in-plane only
D,ALL,UZ,0,,,,ROTX,ROTY
! anchors at both ends
NSEL,R,LOC,X,0
NSEL,R,LOC,Y,0
D,ALL,ALL,0
CMSEL,S,CLNODE
NSEL,R,LOC,X,XEND
NSEL,R,LOC,Y,0
D,ALL,ALL,0
CMSEL,S,CLNODE
! guides: lateral (UY) restraint, first at GD from the bend tangent,
! then every GSPC towards the anchor
*IF,GD,GT,0,THEN
  XT1 = LIN-RBEND
  XT4 = LIN+WL+RBEND
  *DO,KG,0,20
    XG = XT1-GD-KG*GSPC
    *IF,XG,LT,1,EXIT
    D,NODE(XG,0,0),UY,0
    D,NODE(XEND-XG,0,0),UY,0
  *ENDDO
*ENDIF
NSEL,ALL
FINISH
/SOLU
ANTYPE,MODAL
MODOPT,LANB,NMODE
MXPAND,NMODE,,,YES
SOLVE
*DO,IM,1,NMODE
  *GET,FR(IM),MODE,IM,FREQ
*ENDDO
FINISH
/POST1
*DO,IM,1,NMODE
  SET,1,IM
  CMSEL,S,CLNODE
  NSORT,U,SUM
  NSEL,ALL
  *GET,UM(IM),SORT,,MAX
*ENDDO
FINISH
! ---------- write frequencies ----------
  *IF,IC,LE,NCASE,THEN
    *CFOPEN,stage3_results,csv,,APPEND
    *DO,IM,1,NMODE
      F1 = FR(IM)
      U1 = UM(IM)
      *VWRITE,IC,HL,WL,GD,BENDEL,ESZ,NBND,NFOUR,IM,F1,U1
      (F4.0,',',F6.1,',',F6.1,',',F6.1,',',F3.0,',',F7.3,',',F4.0,',',F3.0,',',F3.0,',',F12.5,',',G14.6)
    *ENDDO
    *CFCLOS
  *ENDIF
*ENDDO

! ---------------- baseline: bend stations + mode-shape plots ----------------

! developed distance of each bend midpoint from the reservoir end
QARC = PIV*RBEND/2
SB1  = (LIN-RBEND)+QARC/2
SB2  = SB1+QARC/2+(HL-2*RBEND)+QARC/2
SB3  = SB2+QARC/2+(WL-2*RBEND)+QARC/2
SB4  = SB3+QARC/2+(HL-2*RBEND)+QARC/2
! bend arc centres and midpoints; fluid force on a bend acts from the
! arc centre towards the corner: F = sqrt(2)*p*A along (ex,ey)
C45 = SQRT(0.5)
*DIM,BG,ARRAY,8,4          ! one COLUMN per bend: s, xc, yc, xm, ym, ex, ey, turn
BG(1,1) = SB1,LIN-RBEND,RBEND,0,0,C45,-C45,1
BG(1,2) = SB2,LIN+RBEND,HL-RBEND,0,0,-C45,C45,-1
BG(1,3) = SB3,LIN+WL-RBEND,HL-RBEND,0,0,C45,C45,-1
BG(1,4) = SB4,LIN+WL+RBEND,RBEND,0,0,-C45,-C45,1
*DO,IB,1,4
  BG(4,IB) = BG(2,IB)+RBEND*BG(6,IB)
  BG(5,IB) = BG(3,IB)+RBEND*BG(7,IB)
*ENDDO
*CFOPEN,stage3_bend_geometry,csv
*VWRITE
('bend,s_from_reservoir_m,centre_x_m,centre_y_m,mid_x_m,mid_y_m,force_dir_x,force_dir_y,turn_left1_right-1')
*DO,IB,1,4
  B1=BG(1,IB)
  B2=BG(2,IB)
  B3=BG(3,IB)
  B4=BG(4,IB)
  B5=BG(5,IB)
  B6=BG(6,IB)
  B7=BG(7,IB)
  B8=BG(8,IB)
  *VWRITE,IB,B1,B2,B3,B4,B5,B6,B7,B8
  (F2.0,',',F9.4,',',F9.4,',',F9.4,',',F9.4,',',F9.4,',',F8.4,',',F8.4,',',F3.0)
*ENDDO
*CFCLOS

! mode shapes (mass-normalised) at every centreline node and at the
! bend midpoints
/POST1
CMSEL,S,CLNODE
/NOPR                      ! suppress echo: these loops write ~5000 lines
*CFOPEN,stage3_modeshapes_baseline,csv
*VWRITE
('mode,freq_Hz,node,x_m,y_m,UX,UY,ROTZ')
*DO,IM,1,NMODE
  SET,1,IM
  FRQ = FR(IM)
  *GET,NNOD,NODE,0,COUNT
  ND = 0
  *DO,J,1,NNOD
    ND  = NDNEXT(ND)
    XN  = NX(ND)
    YN  = NY(ND)
    UXN = UX(ND)
    UYN = UY(ND)
    RZN = ROTZ(ND)
    *VWRITE,IM,FRQ,ND,XN,YN,UXN,UYN,RZN
    (F3.0,',',F10.5,',',F7.0,',',F10.4,',',F10.4,',',G14.6,',',G14.6,',',G14.6)
  *ENDDO
*ENDDO
*CFCLOS
*CFOPEN,stage3_modeshapes_at_bends,csv
*VWRITE
('mode,freq_Hz,bend,node,UX,UY,modal_force_component_per_unit_pA')
*DO,IM,1,NMODE
  SET,1,IM
  FRQ = FR(IM)
  *DO,IB,1,4
    ND  = NODE(BG(4,IB),BG(5,IB),0)
    UXN = UX(ND)
    UYN = UY(ND)
    PHF = SQRT(2)*(UXN*BG(6,IB)+UYN*BG(7,IB))
    *VWRITE,IM,FRQ,IB,ND,UXN,UYN,PHF
    (F3.0,',',F10.5,',',F2.0,',',F7.0,',',G14.6,',',G14.6,',',G14.6)
  *ENDDO
*ENDDO
*CFCLOS
/GOPR
NSEL,ALL
FINISH

/RGB,INDEX,100,100,100,0
/RGB,INDEX,0,0,0,15
/PLOPTS,DATE,0
/PLOPTS,WP,0
/TRIAD,OFF
/ESHAPE,1
/VIEW,1,0,0,1
/ANG,1
/AUTO,1
/GFILE,1600
PNGR,COMP,1,-1
PNGR,ORIENT,HORIZ
PNGR,COLOR,2
PNGR,TMOD,1
/POST1
/SHOW,PNG,,0
*DO,IM,1,NMODE
  SET,1,IM
  FRQ = FR(IM)
  /TITLE,Expansion loop (H = %HL% m, W = %WL% m) - in-plane mode %IM% - %FRQ% Hz
  PLNSOL,U,SUM,2
*ENDDO
/SHOW,CLOSE
