B4Y(94,1)=-3.711658099800e+05
B4Y(95,0)=9.400000000000e-02
B4Y(95,1)=-3.711658099800e+05
B4Y(96,0)=9.500000000000e-02
B4Y(96,1)=-3.711658099800e+05
B4Y(97,0)=9.600000000000e-02
B4Y(97,1)=-3.711658099800e+05
B4Y(98,0)=9.700000000000e-02
B4Y(98,1)=-3.711658099800e+05
B4Y(99,0)=9.800000000000e-02
B4Y(99,1)=-3.711658099800e+05
B4Y(100,0)=9.900000000000e-02
B4Y(100,1)=-3.711658099800e+05
B4Y(101,0)=1.000000000000e-01
B4Y(101,1)=-3.711658099800e+05

/SOLU
ANTYPE,TRANS,NEW
! VAout YES is needed for inertial/damping contributions to support reactions.
! Leave MCkey AUTO so that the subsequent expansion pass is supported.
TRNOPT,MSUP,NMOD,,1,YES,NMK,YES
ALPHAD,RAYA
BETAD,RAYB
DELTIM,DTSTR
KBC,0
OUTPR,ALL,NONE
! First MSUP solve establishes ZERO incremental initial conditions at time zero.
FDELE,ALL,ALL
SOLVE
F,BNODE(1),FX,%B1X%
F,BNODE(1),FY,%B1Y%
F,BNODE(2),FX,%B2X%
F,BNODE(2),FY,%B2Y%
F,BNODE(3),FX,%B3X%
F,BNODE(3),FY,%B3Y%
F,BNODE(4),FX,%B4X%
F,BNODE(4),FY,%B4Y%
TIME,TSTOP
SOLVE
FINISH
/SOLU
EXPASS,ON
NUMEXP,ALL,0,TSTOP,YES
OUTRES,ERASE
OUTRES,ALL,NONE
OUTRES,NSOL,ALL
OUTRES,RSOL,ALL
OUTRES,NLOAD,ALL
OUTRES,MISC,ALL
SOLVE
FINISH
/POST1
SET,LAST
RSYS,0
*GET,NSETS,ACTIVE,0,SET,NSET
*DIM,RREC,ARRAY,NSUP,9
*DIM,NREC,ARRAY,4,7
*CFOPEN,stage4_reaction_components,csv
*VWRITE
('t_s,node,type_id,Fx_N,Fy_N,Mz_Nm')
*CFCLOS
*CFOPEN,stage4_msup_history,csv
*VWRITE
('valve_t_s,Uinc_max_m,Utotal_max_m,Snom_total_Pa,support_Ftotal_max_N,support_Finc_max_N')
*CFCLOS
*CFOPEN,stage4_msup_supports,csv
*VWRITE
('valve_t_s,node,RFx_N,RFy_N,RMz_Nm,dRFx_N,dRFy_N,dRMz_Nm')
*CFCLOS
*CFOPEN,stage4_msup_bends,csv
*VWRITE
('valve_t_s,bend,node,UX_total_m,UY_total_m,dUX_m,dUY_m')
*CFCLOS
UPK=0
SPK=0
RPK=0
DURPK=0
TPKU=0
NPKU=0
EPKS=0
! Loop over actual saved result sets, excluding preload sets by time.
*DO,IS,1,NSETS
  SET,,,,,,,IS
  *GET,ATIME,ACTIVE,0,SET,TIME
  *IF,ATIME,LE,0.0000001,CYCLE
  TVAL=ATIME
  FORCE,TOTAL
  CMSEL,S,CLNODE
  ND=0
  UINC=0
  UTOT=0
  *DO,JJ,1,NCL
    ND=NDNEXT(ND)
    UXV=UX(ND)
    UYV=UY(ND)
    DXV=UXV
    DYV=UYV
    UXV=DXV+UBASE(ND,1)
    UYV=DYV+UBASE(ND,2)
    DU=SQRT(DXV**2+DYV**2)
    UU=SQRT(UXV**2+UYV**2)
    UINC=MAX(UINC,DU)
    UTOT=MAX(UTOT,UU)
    *IF,DU,GT,UPK,THEN
      UPK=DU
      TPKU=TVAL
      NPKU=ND
    *ENDIF
  *ENDDO
  RMX=0
  DRMX=0
  *DO,JJ,1,NSUP
    ND=SUPN(JJ)
    RFX=0
    RFY=0
    RMZ=0
    ! Keep the old static-only GET values for comparison via FORCE,STATIC FSUM.
    ALLSEL,ALL
    NSEL,S,NODE,,ND
    SPOINT,ND
    FORCE,STATIC
    FSUM
    *GET,FSX,FSUM,0,ITEM,FX
    *GET,FSY,FSUM,0,ITEM,FY
    *GET,FSM,FSUM,0,ITEM,MZ
    FORCE,DAMP
    FSUM
    *GET,FDX,FSUM,0,ITEM,FX
    *GET,FDY,FSUM,0,ITEM,FY
    *GET,FDM,FSUM,0,ITEM,MZ
    FORCE,INERT
    FSUM
    *GET,FIX,FSUM,0,ITEM,FX
    *GET,FIY,FSUM,0,ITEM,FY
    *GET,FIM,FSUM,0,ITEM,MZ
    FORCE,TOTAL
    FSUM
    *GET,FTX,FSUM,0,ITEM,FX
    *GET,FTY,FSUM,0,ITEM,FY
    *GET,FTM,FSUM,0,ITEM,MZ
    *CFOPEN,stage4_reaction_components,csv,,APPEND
    FTYPE=1
    *VWRITE,TVAL,ND,FTYPE,FSX,FSY,FSM
    (E15.7,',',F8.0,',',F3.0,3(',',E15.7))
    FTYPE=2
    *VWRITE,TVAL,ND,FTYPE,FDX,FDY,FDM
    (E15.7,',',F8.0,',',F3.0,3(',',E15.7))
    FTYPE=3
    *VWRITE,TVAL,ND,FTYPE,FIX,FIY,FIM
    (E15.7,',',F8.0,',',F3.0,3(',',E15.7))
    FTYPE=4
    *VWRITE,TVAL,ND,FTYPE,FTX,FTY,FTM
    (E15.7,',',F8.0,',',F3.0,3(',',E15.7))
    *CFCLOS
    ! Store constrained reaction DOFs only. Unconstrained components remain 0.
    RFY=-FTY
    *IF,JJ,LE,2,THEN
      RFX=-FTX
      RMZ=-FTM
    *ENDIF
    ! Print independent ANSYS reaction calculation at three selected times.
    ICHK=NINT(TVAL/DTSTR)
    *IF,ICHK,EQ,40,THEN
      PRRFOR,F
      PRRFOR,M
    *ENDIF
    *IF,ICHK,EQ,70,THEN
      PRRFOR,F
      PRRFOR,M
    *ENDIF
    *IF,ICHK,EQ,100,THEN
      PRRFOR,F
      PRRFOR,M
    *ENDIF
    ALLSEL,ALL
    DRX=RFX
    DRY=RFY
    DRM=RMZ
    RFX=DRX+RBASE(JJ,1)
    RFY=DRY+RBASE(JJ,2)
    RMZ=DRM+RBASE(JJ,3)
    RMX=MAX(RMX,SQRT(RFX**2+RFY**2))
    DRMX=MAX(DRMX,SQRT(DRX**2+DRY**2))
    RREC(JJ,1)=TVAL
    RREC(JJ,2)=ND
    RREC(JJ,3)=RFX
    RREC(JJ,4)=RFY
    RREC(JJ,5)=RMZ
    RREC(JJ,6)=DRX
    RREC(JJ,7)=DRY
    RREC(JJ,8)=DRM
  *ENDDO
  RPK=MAX(RPK,RMX)
  DURPK=MAX(DURPK,DRMX)
  *CFOPEN,stage4_msup_supports,csv,,APPEND
  *DO,JJ,1,NSUP
    VX1=RREC(JJ,1)
VX2=RREC(JJ,2)
VX3=RREC(JJ,3)
VX4=RREC(JJ,4)
VX5=RREC(JJ,5)
VX6=RREC(JJ,6)
VX7=RREC(JJ,7)
VX8=RREC(JJ,8)
*VWRITE,VX1,VX2,VX3,VX4,VX5,VX6,VX7,VX8
    (E15.7,',',F8.0,6(',',E15.7))
  *ENDDO
  *CFCLOS
  *DO,IB,1,4
    ND=BNODE(IB)
    NREC(IB,1)=TVAL
    NREC(IB,2)=IB
    NREC(IB,3)=ND
    NREC(IB,4)=UX(ND)+UBASE(ND,1)
    NREC(IB,5)=UY(ND)+UBASE(ND,2)
    NREC(IB,6)=UX(ND)
    NREC(IB,7)=UY(ND)
  *ENDDO
  *CFOPEN,stage4_msup_bends,csv,,APPEND
  *DO,IB,1,4
    VX1=NREC(IB,1)
VX2=NREC(IB,2)
VX3=NREC(IB,3)
VX4=NREC(IB,4)
VX5=NREC(IB,5)
VX6=NREC(IB,6)
VX7=NREC(IB,7)
*VWRITE,VX1,VX2,VX3,VX4,VX5,VX6,VX7
    (E15.7,2(',',F8.0),4(',',E15.7))
  *ENDDO
  *CFCLOS
  ALLSEL,ALL
  FORCE,STATIC
  ETABLE,ERAS
  ETABLE,NFORI,SMISC,1
  ETABLE,MYI,SMISC,2
  ETABLE,MZI,SMISC,3
  ETABLE,NFORJ,SMISC,36
  ETABLE,MYJ,SMISC,37
  ETABLE,MZJ,SMISC,38
  *GET,NELEM,ELEM,0,COUNT
  EE=0
  SMAX=0
  *DO,JJ,1,NELEM
    EE=ELNEXT(EE)
    *GET,NI,ELEM,EE,ETAB,NFORI
    *GET,MY1,ELEM,EE,ETAB,MYI
    *GET,MZ1,ELEM,EE,ETAB,MZI
    *GET,NJ,ELEM,EE,ETAB,NFORJ
    *GET,MY2,ELEM,EE,ETAB,MYJ
    *GET,MZ2,ELEM,EE,ETAB,MZJ
    NI=NI+EBASE(EE,1)
    MY1=MY1+EBASE(EE,2)
    MZ1=MZ1+EBASE(EE,3)
    NJ=NJ+EBASE(EE,4)
    MY2=MY2+EBASE(EE,5)
    MZ2=MZ2+EBASE(EE,6)
    SI=ABS(NI)/ASTL+DOUT/2*SQRT(MY1**2+MZ1**2)/IZZ
    SJ=ABS(NJ)/ASTL+DOUT/2*SQRT(MY2**2+MZ2**2)/IZZ
    SNOM=MAX(SI,SJ)
    SMAX=MAX(SMAX,SNOM)
    *IF,SNOM,GT,SPK,THEN
      SPK=SNOM
      EPKS=EE
    *ENDIF
  *ENDDO
  *CFOPEN,stage4_msup_history,csv,,APPEND
  *VWRITE,TVAL,UINC,UTOT,SMAX,RMX,DRMX
  (E18.10,5(',',E18.10))
  *CFCLOS
*ENDDO
*CFOPEN,stage4_msup_summary,csv
*VWRITE
('peak_incremental_U_m,time_s,node,peak_nominal_total_Pa,element')
*VWRITE,UPK,TPKU,NPKU,SPK,EPKS
(E18.10,',',E18.10,',',F8.0,',',E18.10,',',F8.0)
*VWRITE
('peak_total_support_force_N,peak_incremental_support_force_N,rayleigh_alpha,rayleigh_beta')
*VWRITE,RPK,DURPK,RAYA,RAYB
(E18.10,3(',',E18.10))
*CFCLOS
ALLSEL,ALL
FINISH
*CFOPEN,stage4_run_status,txt
*VWRITE
('RECOVERY EXPORT COMPLETED. Review solver errors and comparison before a long run.')
*CFCLOS
