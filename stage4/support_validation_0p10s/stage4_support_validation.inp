! Stage 4 support-reaction validation, 288 modes, 0.100 s, dt 0.001 s.
! Solution/model: command-identical to the user's successful 288-mode run.
! Recovery: user's successful 72-mode diagnostic, with three reaction signs fixed.
! No residual-vector or multiple-load-vector method is used.
! This is a short validation, not a claim of final modal/mesh/time convergence.
! Use a NEW empty MAPDL system and independent LOCAL working directory.
FINISH
/UIS,MSGPOP,3
/TITLE,Stage 4 compact-bend transient benchmark
DOUT=0.813
DINN=0.79394
TWALL=(DOUT-DINN)/2
EYM=213.233E9
NUP=0.3
RHOS=8000
RHOF=455
RBEND=1.4
LTOT=100
GSPC=12
HL=12
WL=8
GD=6
BENDEL=1
ESZ=0.25
NBND=8
NFOUR=8
ALPH=1.4E-5
TREFK=293
TCOLD=111
PIV=ACOS(-1)
ASTL=PIV/4*(DOUT**2-DINN**2)
AFLD=PIV/4*DINN**2
IZZ=PIV/64*(DOUT**4-DINN**4)
RHOEF=(RHOS*ASTL+RHOF*AFLD)/ASTL
/PREP7
ET,1,PIPE289
ET,2,ELBOW290
SECTYPE,1,PIPE
SECDATA,DOUT,TWALL,32
MP,EX,1,EYM
MP,PRXY,1,NUP
MP,DENS,1,RHOEF
MP,ALPX,1,ALPH
TREF,TREFK
FINISH

/PREP7
KEYOPT,2,2,NFOUR
! straight legs so that developed length = LTOT
DRND = 4*(2*RBEND-PIV*RBEND/2)
LIN  = (LTOT-2*HL-WL+DRND)/2
XEND = 2*LIN+WL
K,1,0,0,0
K,2,LIN,0,0
K,3,LIN,HL,0
K,4,LIN+WL,HL,0
K,5,LIN+WL,0,0
K,6,XEND,0,0
L,1,2
L,2,3
L,3,4
L,4,5
L,5,6
*GET,NLST,LINE,0,NUM,MAX
LFILLT,1,2,RBEND
LFILLT,2,3,RBEND
LFILLT,3,4,RBEND
LFILLT,4,5,RBEND
! straights by size, arcs by divisions
LSEL,S,LINE,,1,NLST
LESIZE,ALL,ESZ
LSEL,S,LINE,,NLST+1,NLST+4
LESIZE,ALL,,,NBND
LSEL,ALL
TYPE,BENDEL+1
MAT,1
SECNUM,1
LMESH,ALL
! work only with the pipe-centreline nodes (ELBOW290 also creates
! internal section nodes, which must not receive these constraints)
LSEL,ALL
NSLL,S,1
CM,CLNODE,NODE
! in-plane only
D,ALL,UZ,0,,,,ROTX,ROTY
! Fix exactly the two endpoint centreline nodes by ID.
! Coordinate NSEL at XEND would use a wide default tolerance.
CMSEL,S,CLNODE
NANCH1=NODE(0,0,0)
NANCH2=NODE(XEND,0,0)
D,NANCH1,ALL,0
D,NANCH2,ALL,0
CMSEL,S,CLNODE
! guides: lateral (UY) restraint, first at GD from the bend tangent,
! then every GSPC towards the anchor
*IF,GD,GT,0,THEN
  XT1 = LIN-RBEND
  XT4 = LIN+WL+RBEND
  *DO,KG,0,20
    XG = XT1-GD-KG*GSPC
    *IF,XG,LT,1,EXIT
    D,NODE(XG,0,0),UY,0
    D,NODE(XEND-XG,0,0),UY,0
  *ENDDO
*ENDIF
NSEL,ALL
FINISH

! Identify support nodes on the same actual mesh used by Stage 3.
CMSEL,S,CLNODE
*DIM,SUPN,ARRAY,44
NSUP=2
SUPN(1)=NANCH1
SUPN(2)=NANCH2
*DO,KG,0,20
  XG=LIN-RBEND-GD-KG*GSPC
  *IF,XG,LT,1,EXIT
  NSUP=NSUP+1
  SUPN(NSUP)=NODE(XG,0,0)
  NSUP=NSUP+1
  SUPN(NSUP)=NODE(XEND-XG,0,0)
*ENDDO
ALLSEL,ALL
/OUTPUT,stage4_support_audit,txt
CMSEL,S,CLNODE
DLIST,ALL
/OUTPUT
ALLSEL,ALL

! Four compact loads at the nearest centreline node to each bend midpoint.
CMSEL,S,CLNODE
*DIM,BNODE,ARRAY,4
BNODE(1)=NODE(34.79170000,0.41010000,0)
BNODE(2)=NODE(35.61180000,11.58990000,0)
BNODE(3)=NODE(42.79170000,11.58990000,0)
BNODE(4)=NODE(43.61180000,0.41010000,0)
ALLSEL,ALL
NMOD=288
DTSTR=0.001
TSTOP=0.1
/SOLU
ANTYPE,STATIC,NEW
NLGEOM,OFF
TUNIF,TCOLD
KBC,1
TIME,1
OUTRES,ERASE
OUTRES,ALL,LAST
F,BNODE(1),FX,2.968919286100e+05
F,BNODE(1),FY,-2.968919286100e+05
F,BNODE(2),FX,-2.968919286100e+05
F,BNODE(2),FY,2.968919286100e+05
F,BNODE(3),FX,2.968919286100e+05
F,BNODE(3),FY,2.968919286100e+05
F,BNODE(4),FX,-2.968919286100e+05
F,BNODE(4),FY,-2.968919286100e+05
SOLVE
FINISH
/POST1
SET,LAST
RSYS,0
FORCE,STATIC
CMSEL,S,CLNODE
*GET,NCL,NODE,0,COUNT
*GET,NMAXID,NODE,0,NUM,MAX
*DIM,UBASE,ARRAY,NMAXID,2
ND=0
*DO,JJ,1,NCL
  ND=NDNEXT(ND)
  UBASE(ND,1)=UX(ND)
  UBASE(ND,2)=UY(ND)
*ENDDO
! Store initial support reactions for incremental extraction.
*DIM,RBASE,ARRAY,NSUP,3
*DO,JJ,1,NSUP
  ND=SUPN(JJ)
  *GET,RBASE(JJ,2),NODE,ND,RF,FY
  *IF,JJ,LE,2,THEN
    *GET,RBASE(JJ,1),NODE,ND,RF,FX
    *GET,RBASE(JJ,3),NODE,ND,RF,MZ
  *ENDIF
*ENDDO
ALLSEL,ALL
*CFOPEN,stage4_static_reaction_check,csv
*VWRITE
('node,RFx_N,RFy_N,RMz_Nm,FSUMx_N,FSUMy_N,FSUMmz_Nm')
*DO,KK,1,NSUP
  ND=SUPN(KK)
  NSEL,S,NODE,,ND
  SPOINT,ND
  FORCE,STATIC
  FSUM
  *GET,FSX,FSUM,0,ITEM,FX
  *GET,FSY,FSUM,0,ITEM,FY
  *GET,FSM,FSUM,0,ITEM,MZ
  BX=RBASE(KK,1)
  BY=RBASE(KK,2)
  BM=RBASE(KK,3)
  *VWRITE,ND,BX,BY,BM,FSX,FSY,FSM
  (F8.0,6(',',E16.8))
*ENDDO
*CFCLOS
ALLSEL,ALL
ETABLE,ERAS
ETABLE,NFORI,SMISC,1
ETABLE,MYI,SMISC,2
ETABLE,MZI,SMISC,3
ETABLE,NFORJ,SMISC,36
ETABLE,MYJ,SMISC,37
ETABLE,MZJ,SMISC,38
*GET,EMAXID,ELEM,0,NUM,MAX
*GET,NELEM,ELEM,0,COUNT
*DIM,EBASE,ARRAY,EMAXID,6
EE=0
*DO,JJ,1,NELEM
  EE=ELNEXT(EE)
  *GET,EBASE(EE,1),ELEM,EE,ETAB,NFORI
  *GET,EBASE(EE,2),ELEM,EE,ETAB,MYI
  *GET,EBASE(EE,3),ELEM,EE,ETAB,MZI
  *GET,EBASE(EE,4),ELEM,EE,ETAB,NFORJ
  *GET,EBASE(EE,5),ELEM,EE,ETAB,MYJ
  *GET,EBASE(EE,6),ELEM,EE,ETAB,MZJ
*ENDDO
FINISH
! The modal/transient problem is incremental with zero thermal strain.
! Cold elastic properties remain unchanged; there is no stress stiffening.
/SOLU
ANTYPE,MODAL,NEW
ALLSEL,ALL
FDELE,ALL,ALL
BFDELE,ALL,ALL
BFEDELE,ALL,ALL
TUNIF,TREFK
MODOPT,LANB,NMOD,,,,OFF
MXPAND,NMOD,,,YES,,YES
OUTRES,ERASE
OUTRES,ALL,ALL
OUTRES,NLOAD,ALL
SOLVE
*DIM,FRNEW,ARRAY,NMOD
*DO,IM,1,NMOD
  *GET,FRNEW(IM),MODE,IM,FREQ
*ENDDO
FINISH
*CFOPEN,stage4_modes,csv
*VWRITE
('mode,freq_Hz')
*DO,IM,1,NMOD
  FV=FRNEW(IM)
  *VWRITE,IM,FV
  (F4.0,',',E20.12)
*ENDDO
*CFCLOS
ZETA=0.02
WA=2*PIV*FRNEW(2)
WB=2*PIV*FRNEW(3)
RAYA=2*ZETA*WA*WB/(WA+WB)
RAYB=2*ZETA/(WA+WB)
*DIM,B1X,TABLE,101,1,1,TIME
B1X(0,1)=1.000000000000e+00
B1X(0,1)=1.000000000000e+00
B1X(1,0)=0.000000000000e+00
B1X(1,1)=0.000000000000e+00
B1X(2,0)=9.999999999999e-04
B1X(2,1)=0.000000000000e+00
