SOLVE
FINISH
/POST1
SET,LAST
CMSEL,S,CLNODE
*GET,NCL,NODE,0,COUNT
*GET,NMAXID,NODE,0,NUM,MAX
*DIM,UBASE,ARRAY,NMAXID,2
ND=0
*DO,JJ,1,NCL
  ND=NDNEXT(ND)
  UBASE(ND,1)=UX(ND)
  UBASE(ND,2)=UY(ND)
*ENDDO
! Store initial support reactions for incremental extraction.
*DIM,RBASE,ARRAY,NSUP,3
*DO,JJ,1,NSUP
  ND=SUPN(JJ)
  *GET,RBASE(JJ,2),NODE,ND,RF,FY
  *IF,JJ,LE,2,THEN
    *GET,RBASE(JJ,1),NODE,ND,RF,FX
    *GET,RBASE(JJ,3),NODE,ND,RF,MZ
  *ENDIF
*ENDDO
ALLSEL,ALL
FINISH
/SOLU
TIMINT,ON
KBC,0
TIME,3
DELTIM,0.001
OUTRES,ALL,5
F,BNODE(1),FX,%B1X%
F,BNODE(1),FY,%B1Y%
F,BNODE(2),FX,%B2X%
F,BNODE(2),FY,%B2Y%
F,BNODE(3),FX,%B3X%
F,BNODE(3),FY,%B3Y%
F,BNODE(4),FX,%B4X%
F,BNODE(4),FY,%B4Y%
SOLVE
FINISH
SAVE,stage4_transient,db
/POST1
SET,LAST
RSYS,0
*GET,NSETS,ACTIVE,0,SET,NSET
*DIM,RREC,ARRAY,NSUP,9
*DIM,NREC,ARRAY,4,7
*CFOPEN,stage4_transient_history,csv
*VWRITE
('valve_t_s,Uinc_max_m,Utotal_max_m,Snom_total_Pa,support_Ftotal_max_N,support_Finc_max_N')
*CFCLOS
*CFOPEN,stage4_transient_supports,csv
*VWRITE
('valve_t_s,node,RFx_N,RFy_N,RMz_Nm,dRFx_N,dRFy_N,dRMz_Nm')
*CFCLOS
*CFOPEN,stage4_transient_bends,csv
*VWRITE
('valve_t_s,bend,node,UX_total_m,UY_total_m,dUX_m,dUY_m')
*CFCLOS
UPK=0
SPK=0
RPK=0
DURPK=0
TPKU=0
NPKU=0
EPKS=0
! Loop over actual saved result sets, excluding preload sets by time.
*DO,IS,1,NSETS
  SET,,,,,,,IS
  *GET,ATIME,ACTIVE,0,SET,TIME
  *IF,ATIME,LE,1.0000001,CYCLE
  TVAL=ATIME-1
  CMSEL,S,CLNODE
  ND=0
  UINC=0
  UTOT=0
  *DO,JJ,1,NCL
    ND=NDNEXT(ND)
    UXV=UX(ND)
    UYV=UY(ND)
    DXV=UXV-UBASE(ND,1)
    DYV=UYV-UBASE(ND,2)
    DU=SQRT(DXV**2+DYV**2)
    UU=SQRT(UXV**2+UYV**2)
    UINC=MAX(UINC,DU)
    UTOT=MAX(UTOT,UU)
    *IF,DU,GT,UPK,THEN
      UPK=DU
      TPKU=TVAL
      NPKU=ND
    *ENDIF
  *ENDDO
  RMX=0
  DRMX=0
  *DO,JJ,1,NSUP
    ND=SUPN(JJ)
    RFX=0
    RFY=0
    RMZ=0
    *GET,RFY,NODE,ND,RF,FY
    *IF,JJ,LE,2,THEN
      *GET,RFX,NODE,ND,RF,FX
      *GET,RMZ,NODE,ND,RF,MZ
    *ENDIF
    DRX=RFX-RBASE(JJ,1)
    DRY=RFY-RBASE(JJ,2)
    DRM=RMZ-RBASE(JJ,3)
    RMX=MAX(RMX,SQRT(RFX**2+RFY**2))
    DRMX=MAX(DRMX,SQRT(DRX**2+DRY**2))
    RREC(JJ,1)=TVAL
    RREC(JJ,2)=ND
    RREC(JJ,3)=RFX
    RREC(JJ,4)=RFY
    RREC(JJ,5)=RMZ
    RREC(JJ,6)=DRX
    RREC(JJ,7)=DRY
    RREC(JJ,8)=DRM
  *ENDDO
  RPK=MAX(RPK,RMX)
  DURPK=MAX(DURPK,DRMX)
  *CFOPEN,stage4_transient_supports,csv,,APPEND
  *DO,JJ,1,NSUP
    *VWRITE,RREC(JJ,1),RREC(JJ,2),RREC(JJ,3),RREC(JJ,4),RREC(JJ,5),RREC(JJ,6),RREC(JJ,7),RREC(JJ,8)
    (E15.7,',',F8.0,6(',',E15.7))
  *ENDDO
  *CFCLOS
  *DO,IB,1,4
    ND=BNODE(IB)
    NREC(IB,1)=TVAL
    NREC(IB,2)=IB
    NREC(IB,3)=ND
    NREC(IB,4)=UX(ND)
    NREC(IB,5)=UY(ND)
    NREC(IB,6)=UX(ND)-UBASE(ND,1)
    NREC(IB,7)=UY(ND)-UBASE(ND,2)
  *ENDDO
  *CFOPEN,stage4_transient_bends,csv,,APPEND
  *DO,IB,1,4
    *VWRITE,NREC(IB,1),NREC(IB,2),NREC(IB,3),NREC(IB,4),NREC(IB,5),NREC(IB,6),NREC(IB,7)
    (E15.7,2(',',F8.0),4(',',E15.7))
  *ENDDO
  *CFCLOS
  ALLSEL,ALL
  ETABLE,ERAS
  ETABLE,NFORI,SMISC,1
  ETABLE,MYI,SMISC,2
  ETABLE,MZI,SMISC,3
  ETABLE,NFORJ,SMISC,36
  ETABLE,MYJ,SMISC,37
  ETABLE,MZJ,SMISC,38
  *GET,NELEM,ELEM,0,COUNT
  EE=0
  SMAX=0
  *DO,JJ,1,NELEM
    EE=ELNEXT(EE)
    *GET,NI,ELEM,EE,ETAB,NFORI
    *GET,MY1,ELEM,EE,ETAB,MYI
    *GET,MZ1,ELEM,EE,ETAB,MZI
    *GET,NJ,ELEM,EE,ETAB,NFORJ
    *GET,MY2,ELEM,EE,ETAB,MYJ
    *GET,MZ2,ELEM,EE,ETAB,MZJ
    SI=ABS(NI)/ASTL+DOUT/2*SQRT(MY1**2+MZ1**2)/IZZ
    SJ=ABS(NJ)/ASTL+DOUT/2*SQRT(MY2**2+MZ2**2)/IZZ
    SNOM=MAX(SI,SJ)
    SMAX=MAX(SMAX,SNOM)
    *IF,SNOM,GT,SPK,THEN
      SPK=SNOM
      EPKS=EE
    *ENDIF
  *ENDDO
  *CFOPEN,stage4_transient_history,csv,,APPEND
  *VWRITE,TVAL,UINC,UTOT,SMAX,RMX,DRMX
  (E18.10,5(',',E18.10))
  *CFCLOS
*ENDDO
*CFOPEN,stage4_transient_summary,csv
*VWRITE
('peak_incremental_U_m,time_s,node,peak_nominal_total_Pa,element')
*VWRITE,UPK,TPKU,NPKU,SPK,EPKS
(E18.10,',',E18.10,',',F8.0,',',E18.10,',',F8.0)
*VWRITE
('peak_total_support_force_N,peak_incremental_support_force_N,rayleigh_alpha,rayleigh_beta')
*VWRITE,RPK,DURPK,RAYA,RAYB
(E18.10,3(',',E18.10))
*CFCLOS
ALLSEL,ALL
SET,LAST
FINISH
