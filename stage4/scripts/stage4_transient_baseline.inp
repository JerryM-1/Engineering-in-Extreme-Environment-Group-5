! STAGE 4 - corrected supports, full transient, compact-bend loading
! Run in a NEW empty Mechanical APDL system. All load data are embedded.
! Closure 0.02 s, structural step 0.001 s, hydraulic MOC step 0.00022727 s.
! 2 s initial trial. Results every 5 structural steps. Refine time/output spacing later.
! Static preload: uniform cooldown plus initial compact-bend fluid forces.
! Pressure is represented ONLY by compact bend forces, including steady momentum.
! No element pressure is applied: hoop stress, pressure stiffening, cap reactions
! and a code-compliant combined pressure stress require additional modelling.
! Linear small-deflection elastic benchmark with cold E and constant alpha.
! Negative absolute hydraulic pressures are retained as ideal continuation.
! Post-reflection results from that continuation are not physical two-phase LNG predictions.
! Nominal output is longitudinal force/bending stress only, without stress intensification.
! Rayleigh damping is 2% at corrected modes 2 and 3, frequency-dependent elsewhere.
! ANSYS execution pending. Input structure and data checked in Python only.
! MECH0074 Stage 4 - baseline cooldown only, revision 2
! Corrects endpoint coordinate-selection tolerance and guide reaction export.
! Adapted from the supplied Stage 3 v5 model.
! SI units: m, kg, s, Pa. Temperatures use K consistently.
! Run in a NEW Mechanical APDL system/session and a separate working folder.
! Linear elastic small-displacement isolated thermal-load case.
! E at 111 K and constant alpha are used over the whole cooldown.
! Static pressure and valve transient are subsequent load cases.
! Nominal longitudinal stress = |N|/A + Ro*sqrt(My^2+Mz^2)/I.
! It is a beam-resultant envelope, not a code stress or local peak stress.
! APDL execution must be verified in ANSYS; generated outside ANSYS.
FINISH
/UIS,MSGPOP,3
/TITLE,Stage 4 compact-bend transient benchmark
DOUT=0.813
DINN=0.79394
TWALL=(DOUT-DINN)/2
EYM=213.233E9
NUP=0.3
RHOS=8000
RHOF=455
RBEND=1.4
LTOT=100
GSPC=12
HL=12
WL=8
GD=6
BENDEL=1
ESZ=0.25
NBND=8
NFOUR=8
ALPH=1.4E-5
TREFK=293
TCOLD=111
PIV=ACOS(-1)
ASTL=PIV/4*(DOUT**2-DINN**2)
AFLD=PIV/4*DINN**2
IZZ=PIV/64*(DOUT**4-DINN**4)
RHOEF=(RHOS*ASTL+RHOF*AFLD)/ASTL
/PREP7
ET,1,PIPE289
ET,2,ELBOW290
SECTYPE,1,PIPE
SECDATA,DOUT,TWALL,32
MP,EX,1,EYM
MP,PRXY,1,NUP
MP,DENS,1,RHOEF
MP,ALPX,1,ALPH
TREF,TREFK
FINISH

/PREP7
KEYOPT,2,2,NFOUR
! straight legs so that developed length = LTOT
DRND = 4*(2*RBEND-PIV*RBEND/2)
LIN  = (LTOT-2*HL-WL+DRND)/2
XEND = 2*LIN+WL
K,1,0,0,0
K,2,LIN,0,0
K,3,LIN,HL,0
K,4,LIN+WL,HL,0
K,5,LIN+WL,0,0
K,6,XEND,0,0
L,1,2
L,2,3
L,3,4
L,4,5
L,5,6
*GET,NLST,LINE,0,NUM,MAX
LFILLT,1,2,RBEND
LFILLT,2,3,RBEND
LFILLT,3,4,RBEND
LFILLT,4,5,RBEND
! straights by size, arcs by divisions
LSEL,S,LINE,,1,NLST
LESIZE,ALL,ESZ
LSEL,S,LINE,,NLST+1,NLST+4
LESIZE,ALL,,,NBND
LSEL,ALL
TYPE,BENDEL+1
MAT,1
SECNUM,1
LMESH,ALL
! work only with the pipe-centreline nodes (ELBOW290 also creates
! internal section nodes, which must not receive these constraints)
LSEL,ALL
NSLL,S,1
CM,CLNODE,NODE
! in-plane only
D,ALL,UZ,0,,,,ROTX,ROTY
! Fix exactly the two endpoint centreline nodes by ID.
! Coordinate NSEL at XEND would use a wide default tolerance.
CMSEL,S,CLNODE
NANCH1=NODE(0,0,0)
NANCH2=NODE(XEND,0,0)
D,NANCH1,ALL,0
D,NANCH2,ALL,0
CMSEL,S,CLNODE
! guides: lateral (UY) restraint, first at GD from the bend tangent,
! then every GSPC towards the anchor
*IF,GD,GT,0,THEN
  XT1 = LIN-RBEND
  XT4 = LIN+WL+RBEND
  *DO,KG,0,20
    XG = XT1-GD-KG*GSPC
    *IF,XG,LT,1,EXIT
    D,NODE(XG,0,0),UY,0
    D,NODE(XEND-XG,0,0),UY,0
  *ENDDO
*ENDIF
NSEL,ALL
FINISH

! Identify support nodes on the same actual mesh used by Stage 3.
CMSEL,S,CLNODE
*DIM,SUPN,ARRAY,44
NSUP=2
SUPN(1)=NANCH1
SUPN(2)=NANCH2
*DO,KG,0,20
  XG=LIN-RBEND-GD-KG*GSPC
  *IF,XG,LT,1,EXIT
  NSUP=NSUP+1
  SUPN(NSUP)=NODE(XG,0,0)
  NSUP=NSUP+1
  SUPN(NSUP)=NODE(XEND-XG,0,0)
*ENDDO
ALLSEL,ALL
/OUTPUT,stage4_constraint_audit,txt
CMSEL,S,CLNODE
DLIST,ALL
/OUTPUT
ALLSEL,ALL

! Four compact loads at the nearest centreline node to each bend midpoint.
CMSEL,S,CLNODE
*DIM,BNODE,ARRAY,4
BNODE(1)=NODE(34.79170000,0.41010000,0)
BNODE(2)=NODE(35.61180000,11.58990000,0)
BNODE(3)=NODE(42.79170000,11.58990000,0)
BNODE(4)=NODE(43.61180000,0.41010000,0)
ALLSEL,ALL
! Recompute six modes for the corrected endpoint constraints.
/SOLU
ANTYPE,MODAL
MODOPT,LANB,6
MXPAND,6,,,YES
SOLVE
*DIM,FRNEW,ARRAY,6
*DO,IM,1,6
  *GET,FRNEW(IM),MODE,IM,FREQ
*ENDDO
FINISH
*CFOPEN,stage4_corrected_modes,csv
*VWRITE
('mode,frequency_Hz')
*DO,IM,1,6
  FNEW=FRNEW(IM)
  *VWRITE,IM,FNEW
  (F3.0,',',E20.12)
*ENDDO
*CFCLOS
ZETA=0.02
WA=2*PIV*FRNEW(2)
WB=2*PIV*FRNEW(3)
RAYA=2*ZETA*WA*WB/(WA+WB)
RAYB=2*ZETA/(WA+WB)
! TABLE independent variable is absolute analysis time: 1 s + valve time.
! The first second establishes static equilibrium and is not physical cooldown time.
*DIM,B1X,TABLE,2001,1,1,TIME
B1X(0,1)=1
B1X(1,0)=1.000000000
B1X(1,1)=2.9689192861e+05
B1X(2,0)=1.001000000
B1X(2,1)=2.9689192861e+05
