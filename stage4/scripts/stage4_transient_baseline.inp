/SOLU
ANTYPE,TRANS,NEW
TRNOPT,FULL
NLGEOM,OFF
ALPHAD,RAYA
BETAD,RAYB
AUTOTS,OFF
TUNIF,TCOLD
! Two stepped static substeps establish zero initial velocity.
TIMINT,OFF
KBC,1
TIME,1
NSUBST,2
OUTRES,ALL,ALL
F,BNODE(1),FX,2.9689192861e+05
F,BNODE(1),FY,-2.9689192861e+05
F,BNODE(2),FX,-2.9689192861e+05
F,BNODE(2),FY,2.9689192861e+05
F,BNODE(3),FX,2.9689192861e+05
F,BNODE(3),FY,2.9689192861e+05
