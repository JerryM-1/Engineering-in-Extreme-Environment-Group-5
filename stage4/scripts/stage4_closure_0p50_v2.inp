B4Y(1992,0)=1.991000000000e+00
B4Y(1992,1)=-8.396439618092e+04
B4Y(1993,0)=1.992000000000e+00
B4Y(1993,1)=-8.322114508227e+04
B4Y(1994,0)=1.993000000000e+00
B4Y(1994,1)=-8.247789804660e+04
B4Y(1995,0)=1.994000000000e+00
B4Y(1995,1)=-8.173465507392e+04
B4Y(1996,0)=1.995000000000e+00
B4Y(1996,1)=-8.099141612234e+04
B4Y(1997,0)=1.996000000000e+00
